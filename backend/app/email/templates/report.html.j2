<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#F3F4F6;font-family:'Noto Sans','Noto Sans Devanagari',Arial,sans-serif;color:#1F2937;">
<div style="max-width:620px;margin:0 auto;padding:16px;">
  <div style="background:#FFFFFF;border:1px solid #E5E7EB;border-radius:12px;padding:20px;">
    <h1 style="font-size:20px;margin:0 0 8px 0;">{{ subject }}</h1>
    <p style="font-size:16px;margin:0 0 4px 0;">{{ s.greeting }}</p>
    <p style="font-size:16px;margin:0 0 16px 0;">{{ s.intro.format(period=period) }}</p>

    {% for it in items %}
    <div style="border:1px solid #E5E7EB;border-radius:8px;padding:14px;margin:0 0 14px 0;">
      <h2 style="font-size:18px;margin:0 0 8px 0;">{{ it.item }}</h2>
      <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;font-size:15px;margin:0 0 10px 0;">
        <tr><td style="padding:2px 0;color:#6B7280;">{{ s.expected }}</td><td style="padding:2px 0;text-align:right;">{{ it.expected }} {{ it.unit }}</td></tr>
        <tr><td style="padding:2px 0;color:#6B7280;">{{ s.received }}</td><td style="padding:2px 0;text-align:right;">{{ it.received }} {{ it.unit }}</td></tr>
        <tr><td style="padding:2px 0;color:#6B7280;">{{ s.remaining }}</td><td style="padding:2px 0;text-align:right;">{{ it.remaining }} {{ it.unit }}</td></tr>
        <tr><td style="padding:2px 0;color:#6B7280;">{{ s.difference }}</td><td style="padding:2px 0;text-align:right;">{{ it.difference }} {{ it.unit }}</td></tr>
      </table>
      <p style="font-size:15px;line-height:1.5;margin:0 0 8px 0;">{{ it.sentence }}</p>
      <p style="font-size:15px;line-height:1.5;margin:0 0 8px 0;">{{ it.balance }}</p>
      {% for n in it.notes %}
      <p style="font-size:14px;line-height:1.5;margin:0 0 8px 0;color:#6B7280;">{{ n }}</p>
      {% endfor %}
    </div>
    {% endfor %}

    {% for n in notes %}
    <p style="font-size:14px;line-height:1.5;margin:0 0 12px 0;color:#6B7280;">{{ n }}</p>
    {% endfor %}

    <p style="font-size:13px;line-height:1.5;margin:0 0 16px 0;color:#6B7280;">{{ s.carry_note }}</p>

    <p style="margin:0 0 4px 0;"><a href="{{ link }}" style="display:inline-block;background:#1F2937;color:#FFFFFF;text-decoration:none;padding:12px 18px;border-radius:8px;font-size:16px;">{{ s.open_report }}</a></p>
    <p style="font-size:13px;margin:0 0 16px 0;color:#6B7280;">{{ s.link_note }}</p>

    <p style="font-size:13px;line-height:1.5;margin:0 0 8px 0;color:#6B7280;">{{ s.report_footer }}</p>
  </div>
  <p style="font-size:12px;line-height:1.5;color:#6B7280;margin:12px 4px;">{{ s.email_footer }}</p>
</div>
</body>
</html>
