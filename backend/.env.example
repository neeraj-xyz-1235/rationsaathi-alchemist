DATABASE_URL=
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
ENABLE_DOCS=true
SEED_PASSWORD=

# --- Receipt reading (optional). Leave empty = regex reader only, which always works. ---
# Any FREE OpenAI-compatible API. Check the provider's current free limits before relying on it.
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1
#               LLM_MODEL=llama-3.3-70b-versatile
#   Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#               LLM_MODEL=gemini-2.0-flash
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#               LLM_MODEL=<a model whose name ends in ":free">
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1   (runs on your PC, no key, no limits)
#               LLM_MODEL=qwen2.5:7b      (ollama pull qwen2.5:7b)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=8

# --- Emailing a report (optional; the button is hidden/503 without these) ---
# Brevo (default): free daily quota; verify ONE sender address in Brevo, no domain needed.
# Resend: needs a verified domain before it can send to anyone but you.
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=
EMAIL_FROM=RationSaathi <your-verified-sender@example.com>
